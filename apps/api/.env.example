# Pooled Neon connection string. Unlike pipeline/.env.example (which uses
# the direct connection for a one-off batch script), the API holds a live
# connection pool, so it must go through Neon's pooler endpoint.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"
