# Pooled Neon connection string. Unlike pipeline/.env.example (which uses
# the direct connection for a one-off batch script), the API holds a live
# connection pool, so it must go through Neon's pooler endpoint.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# Supabase project settings: Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Shared with people you trust; required to complete registration.
REGISTRATION_ACCESS_CODE="change-me"
